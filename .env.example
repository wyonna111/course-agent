OPENAI_API_KEY=你的密钥
OPENAI_API_BASE=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Phase 2（联网搜索默认 true，无需额外 Key）
ENABLE_WEB_SEARCH=true
ENABLE_CORRECTIONS=true
ENABLE_WORKSPACE=true
USE_LLM_REWRITE_QUERY=false
ENABLE_LLM_RERANK=true
ENABLE_SELF_RAG=true

# 检索器类型：tfidf（默认）或 embedding（语义向量，首次需下载约90MB模型）
RETRIEVER_TYPE=embedding

# 多模态图片理解（可选，不填则跳过图片处理）
# 推荐：阿里云百炼 qwen-vl-plus，国内可用，注册即送免费额度
# 注册地址：https://bailian.console.aliyun.com/
VISION_MODEL_NAME=qwen-vl-plus
VISION_API_KEY=你的阿里云百炼Key
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Phase 3：参考文献 DOI（CrossRef 可选）
ENABLE_REFERENCES=true
REFERENCE_FETCH_META=true
REFERENCE_CROSSREF_SEARCH=true
# 填写邮箱可提高 CrossRef 配额礼貌池（可选）
# CROSSREF_MAILTO=you@example.com
REFERENCE_FETCH_TIMEOUT=8
